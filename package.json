{
  "name": "soleil",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:up": "bash scripts/dev-db.sh",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "sync": "tsx scripts/sync.ts",
    "test": "find src scripts -name '*.test.ts' -print0 | sort -z | xargs -0 node_modules/.bin/tsx --test --import tsx",
    "sync:backfill": "tsx scripts/sync.ts --backfill 600 --no-predict --no-settle",
    "probe": "tsx scripts/probe-api.ts",
    "probe:dry": "tsx scripts/probe-api.ts --dry-run",
    "test:probe": "tsx --test --import tsx scripts/__tests__/*.test.ts",
    "compare": "tsx scripts/compare-sources.ts",
    "compare:advanced": "tsx scripts/compare-advanced.ts",
    "backtest": "tsx scripts/backtest/run.ts",
    "backtest:plan": "tsx scripts/backtest/xg-plan.ts",
    "backtest:enrich": "tsx scripts/backtest/xg-enrich.ts",
    "compare:stats": "tsx scripts/compare-stats-bulk.ts",
    "backtest:phase12": "tsx scripts/backtest/phase12.ts",
    "backtest:phase13": "tsx scripts/backtest/phase13.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/react-query": "^5.104.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.7",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
